# --- Translation (default: OpenRouter) ---
OPENROUTER_API_KEY=
# Any OpenRouter model id. Default is google/gemini-2.5-flash-lite ($0.10 in / $0.40 out per 1M tokens).
# Cheaper to try: qwen/qwen3.7-flash. Browse https://openrouter.ai/models
OPENROUTER_MODEL=google/gemini-2.5-flash-lite

# Optional: use Claude directly instead of OpenRouter
# TRANSLATE_PROVIDER=anthropic
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-haiku-5-5

# --- Speech to text ---
DEEPGRAM_API_KEY=

# --- Server ---
# Shared secret the app sends as ?token=... (the WebView can't set WebSocket headers)
HONYAKU_TOKEN=change-me
PORT=8787
