# --- Translation ---
# Default (no LLM): Google Cloud Translation. Romaji is generated locally, so no other service is needed.
# Create a key: Google Cloud console → enable "Cloud Translation API" → APIs & Services → Credentials → API key.
# Free tier: 500,000 characters/month, then $20 per 1M characters.
GOOGLE_TRANSLATE_API_KEY=

# Or use an LLM instead (higher-quality, context-aware, pay per token). Chosen automatically when
# GOOGLE_TRANSLATE_API_KEY is empty, or force with TRANSLATE_PROVIDER=openrouter|anthropic|google.
# TRANSLATE_PROVIDER=openrouter
OPENROUTER_API_KEY=
# Any OpenRouter model id. Default is google/gemini-2.5-flash-lite ($0.10 in / $0.40 out per 1M tokens).
OPENROUTER_MODEL=google/gemini-2.5-flash-lite
# TRANSLATE_PROVIDER=anthropic
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-haiku-5-5

# --- Speech to text ---
DEEPGRAM_API_KEY=

# How always-on listening decides English vs Japanese (hold-to-talk on the phone is always English):
#   dual  (default) – a dedicated Japanese model + a dedicated English model on the same audio, Japanese wins ties.
#                     Most reliable (no Japanese mistaken for English); uses 2x Deepgram audio minutes.
#   ja              – Japanese only; everything heard is translated to English. Cheapest.
#   multi           – one multilingual stream. Cheapest bilingual, but often starts Japanese as English text.
# LISTEN_ENGINE=dual

# --- Server ---
# Shared secret the app sends as ?token=... (the WebView can't set WebSocket headers).
# Must equal VITE_SERVER_TOKEN in the app's .env.local.
HONYAKU_TOKEN=change-me
PORT=8787
