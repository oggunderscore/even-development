{
  "name": "even-honyaku",
  "private": true,
  "version": "1.1.8",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 5173",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "simulator": "evenhub-simulator http://localhost:5173",
    "qr": "evenhub qr --http --port 5173",
    "pack": "npm run build && evenhub pack app.json dist -o even-honyaku.ehpk --sdk-ver 0.0.16",
    "test": "vitest run",
    "typecheck": "tsc",
    "dict:manifest": "node scripts/dict-manifest.mjs",
    "test:live": "vitest run src/live.test.ts"
  },
  "dependencies": {
    "@evenrealities/even_hub_sdk": "0.0.16",
    "kuromoji": "0.1.2",
    "wanakana": "^5.3.1"
  },
  "devDependencies": {
    "@evenrealities/evenhub-cli": "^0.1.14",
    "@evenrealities/evenhub-simulator": "^0.9.5",
    "@types/kuromoji": "^0.1.3",
    "@types/node": "^22.20.5",
    "typescript": "^5.9.3",
    "vite": "^7.3.1",
    "vitest": "^4.1.12"
  },
  "engines": {
    "node": "^20.0.0 || >=22.0.0"
  },
  "allowScripts": {
    "fsevents@2.3.3": true,
    "esbuild@0.28.2": true
  }
}
