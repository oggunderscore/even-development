{
  "name": "even-honyaku",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 5173",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "simulator": "evenhub-simulator http://localhost:5173",
    "qr": "evenhub qr --http --port 5173",
    "server": "npm --prefix server run dev",
    "pack": "npm run build && evenhub pack app.json dist -o even-honyaku.ehpk",
    "test": "vitest run",
    "typecheck": "tsc"
  },
  "dependencies": {
    "@evenrealities/even_hub_sdk": "^0.0.10"
  },
  "devDependencies": {
    "@evenrealities/evenhub-cli": "^0.1.12",
    "@evenrealities/evenhub-simulator": "^0.7.2",
    "typescript": "^5.9.3",
    "vite": "^7.3.1",
    "vitest": "^4.1.12"
  },
  "engines": {
    "node": "^20.0.0 || >=22.0.0"
  }
}
