# Optional build-time defaults. Everything here can also be set (and overridden) in the app's Settings tab,
# so a build meant for other people should leave the token EMPTY — anything here is baked into the .ehpk.
#
# Phone-reachable address of the proxy server (LAN / Tailscale IP, wss:// for anything public). Not localhost on a phone.
VITE_SERVER_URL=ws://192.168.1.50:8787
# Access token: must match HONYAKU_TOKEN in server/.env
VITE_SERVER_TOKEN=
