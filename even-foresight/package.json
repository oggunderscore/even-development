{
    "name": "even-foresight",
    "private": true,
    "version": "0.1.0",
    "author": "ogg_ <wKey Industries>",
    "type": "module",
    "scripts": {
        "predev": "npm run dev:stop --silent",
        "dev": "vite --host 0.0.0.0 --port 5174 & VITE_PID=$!; trap 'kill $VITE_PID $SIM_PID 2>/dev/null' EXIT INT TERM; evenhub-simulator http://localhost:5174 --automation-port 9898 & SIM_PID=$!; wait $SIM_PID",
        "dev:vite": "vite --host 0.0.0.0 --port 5174",
        "dev:stop": "lsof -ti tcp:5174 | xargs kill 2>/dev/null; true",
        "build": "tsc && vite build",
        "preview": "vite preview",
        "qr": "evenhub qr --http --port 5174 --ip $(tailscale ip -4)",
        "sim": "evenhub-simulator http://localhost:5174 --automation-port 9898",
        "test": "vitest --run",
        "test:watch": "vitest"
    },
    "dependencies": {
        "@evenrealities/even_hub_sdk": "^0.0.10",
        "@evenrealities/pretext": "^0.1.4"
    },
    "devDependencies": {
        "@evenrealities/evenhub-simulator": "^0.7.3",
        "fast-check": "^4.0.0",
        "jsdom": "^29.1.1",
        "typescript": "^5.9.3",
        "vite": "^6.0.0",
        "vitest": "^3.2.0"
    },
    "engines": {
        "node": "^20.0.0 || >=22.0.0"
    },
    "allowScripts": {
        "esbuild@0.25.12": true,
        "fsevents@2.3.3": true
    }
}
